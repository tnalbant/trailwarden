--swiftversion 6.0
--indent 4
--maxwidth 110
--wraparguments before-first
--wrapparameters before-first
--closingparen same-line
--stripunusedargs closure-only
--commas inline
--self remove
--exclude .build,Trailwarden.xcodeproj,docs,Sources/TrailwardenCore/Rules/BuiltInRules.swift
