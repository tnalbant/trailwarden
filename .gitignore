# SwiftPM
.build/
.swiftpm/

# Never commit real agent transcripts. Only hand-written synthetic fixtures
# under Tests/**/Fixtures/ are allowed to be tracked as .jsonl.
*.jsonl
!Tests/**/Fixtures/**/*.jsonl

# Local secrets / databases
.env
*.pem
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Editors
.vscode/
.idea/

# Built at pack time by packaging/npm/scripts/prepack.js; never committed.
packaging/npm/vendor/
